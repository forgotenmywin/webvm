# ---------- Stage 1: Builder (فقط برای کامپایل xmrig، در image نهایی نمی‌مونه) ----------
FROM --platform=linux/386 docker.io/i386/debian:buster AS builder
ARG DEBIAN_FRONTEND=noninteractive

RUN echo "deb [trusted=yes] http://archive.debian.org/debian buster main contrib non-free" \
  > /etc/apt/sources.list && \
  echo "deb [trusted=yes] http://archive.debian.org/debian-security buster/updates main" \
  >> /etc/apt/sources.list

RUN apt-get update && \
    apt-get -y install \
    git ca-certificates build-essential cmake pkg-config \
    libuv1-dev libssl-dev libhwloc-dev

RUN git clone https://github.com/xmrig/xmrig.git /opt/xmrig-src && \
    cd /opt/xmrig-src && mkdir build && cd build && \
    cmake .. -DWITH_HWLOC=OFF && \
    make -j$(nproc)

# ---------- Stage 2: Final image (محیط اصلی شما) ----------
FROM --platform=linux/386 docker.io/i386/debian:buster
ARG DEBIAN_FRONTEND=noninteractive

RUN echo "deb [trusted=yes] http://archive.debian.org/debian buster main contrib non-free" \
  > /etc/apt/sources.list && \
  echo "deb [trusted=yes] http://archive.debian.org/debian-security buster/updates main" \
  >> /etc/apt/sources.list

RUN apt-get update && \
    apt-get -y upgrade

RUN apt-get -y install \
    apt-utils gcc \
    python3 vim unzip ruby nodejs \
    fakeroot dbus base whiptail hexedit \
    patch wamerican ucf manpages \
    file luajit make lua5.3 dialog curl \
    less cowsay netcat-openbsd \
    wget tar policykit-1 \
    libuv1 libssl1.1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# فقط باینری کامپایل‌شده از استیج builder کپی می‌شه، نه کل toolchain ساخت
COPY --from=builder /opt/xmrig-src/build/xmrig /usr/local/bin/xmrig

RUN useradd -m -s /bin/bash user && \
    echo "user:password" | chpasswd && \
    echo "root:password" | chpasswd

COPY --chown=user:user ./examples /home/user/examples

RUN chmod -R +x /home/user/examples/lua

WORKDIR /home/user/

ENV HOME="/home/user" \
    TERM="xterm" \
    USER="user" \
    SHELL="/bin/bash" \
    EDITOR="vim" \
    LANG="C.UTF-8"

CMD ["/bin/bash"]
